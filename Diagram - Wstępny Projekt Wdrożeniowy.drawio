        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Definicje kolorów do wyróżnienia kluczowych procesów bezpieczeństwa\n    classDef authn fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;\n    classDef authz fill:#e8f5e9,stroke:#388e3c,stroke-width:2px;\n\n    subgraph FRONTEND [1. Frontend Developer - Interfejs Kiosku]\n        UI_Scan[Przycisk: Skanuj]\n        UI_Admin[Panel Administratora]\n        UI_Result[Komunikat: Dostęp Przyznany / Odmowa]\n    end\n\n    subgraph BACKEND [2. Backend Developer - API, Logika, Baza]\n        API_Scan[Endpoint: /api/scan]\n        API_Add[Endpoint: /api/add_user]\n        \n        AUTHN{\&quot;AUTENTYFIKACJA\\n(Weryfikacja Tożsamości:\\nPewność z modelu &gt;= 85%)\&quot;}:::authn\n        AUTHZ{\&quot;AUTORYZACJA\\n(Sprawdzenie Uprawnień:\\nCzy to ID ma prawo wejścia?)\&quot;}:::authz\n        DB[(Baza SQLite:\\nUżytkownicy, Uprawnienia, Logi)]\n    end\n\n    subgraph CV [3. Inżynier Wizji - Przetwarzanie i Bezpieczeństwo]\n        CV_Cam((Kamera))\n        CV_Liveness[Liveness Detection\\nTest Mrugnięcia]\n        CV_Process[Wycięcie ROI i Preprocessing]\n        CV_Record[Zapis serii 300 kadrów]\n    end\n\n    subgraph ML [4. Inżynier ML - AI VGG-16]\n        ML_Predict[Predykcja i ocena prawdopodobieństwa]\n        ML_Train[Trening: Transfer Learning nowej głowicy]\n        ML_Weights[(Zapisane Wagi Modelu .h5)]\n    end\n\n    %% ==========================================\n    %% PRZEBIEG 1: AUTORYZACJA WEJŚCIA (Główna oś)\n    %% ==========================================\n    UI_Scan ==&gt;|1. Wyślij żądanie wejścia| API_Scan\n    API_Scan --&gt;|2. Uruchom widzenie maszynowe| CV_Cam\n    CV_Cam --&gt;|3. Przechwyć obraz| CV_Liveness\n    CV_Liveness --&gt;|4. Test mrugnięcia zaliczony| CV_Process\n    CV_Process --&gt;|5. Podaj znormalizowany kadr| ML_Predict\n    ML_Weights -.-&gt; ML_Predict\n    \n    ML_Predict ==&gt;|6. Zwróć wynik np. User_01, 92%| AUTHN\n    \n    %% Decyzje Autentyfikacji\n    AUTHN ==&gt;|7. Tożsamość uwierzytelniona| AUTHZ\n    AUTHN -.-&gt;|Odmowa: Oszustwo lub pewność &lt;85%| API_Scan\n    \n    %% Decyzje Autoryzacji\n    AUTHZ ==&gt;|8. Użytkownik posiada uprawnienia| DB\n    AUTHZ -.-&gt;|Odmowa: Brak dostępu w bazie| API_Scan\n    \n    DB --&gt;|9. Zapisz sukces w logach| API_Scan\n    API_Scan ==&gt;|10. Zwróć ostateczną odpowiedź| UI_Result\n\n    %% ==========================================\n    %% PRZEBIEG 2: DODAWANIE OSOBY (Oś boczna)\n    %% ==========================================\n    UI_Admin --&gt;|A. Rejestruj nowe ID| API_Add\n    API_Add --&gt;|B. Tryb zbierania klatek| CV_Record\n    CV_Record --&gt;|C. Dataset gotowy| ML_Train\n    ML_Train --&gt;|D. Zaktualizuj klasyfikator| ML_Weights\n    ML_Train --&gt;|E. Zwróć flagę sukcesu| API_Add\n    API_Add --&gt;|F. Wyświetl komunikat na ekranie| UI_Admin&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="OxYFn4nOzm9qGQ3C-QmS-43">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
